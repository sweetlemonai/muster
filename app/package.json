{
  "name": "muster-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "app": "tauri dev",
    "release:build": "tauri build --bundles app",
    "check": "pnpm typecheck && pnpm test && pnpm build && cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "markdown-it": "15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
