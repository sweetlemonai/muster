<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- macOS 26's app icon, light, dark and tinted, from the asset catalog that
       icons/build-icons.sh compiles out of icons/Muster.icon (task 0085);
       tauri.conf.json copies it in as Resources/Assets.car. icon.icns is the
       fallback for earlier macOS. -->
  <key>CFBundleIconName</key>
  <string>Muster</string>
  <!-- The languages Muster has (mu-146, i18n::LOCALES and src/i18n/locales.ts),
       as Drover declares its own: macOS lists Muster for them in System
       Settings › General › Language & Region › Applications and keeps the
       one picked there as the app's AppleLanguages, which i18n.rs reads first. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>fa</string>
  </array>
</dict>
</plist>
