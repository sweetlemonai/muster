#!/bin/sh
# Muster's gate (task 0023): every check this repo has, run from the checkout it's in, quietly.
# A session runs it before `muster pass <id> --from building --gate "<its last line>"
# --summary "<what was built>"`, and a merge runs it in the task's worktree (`muster projects set
# muster gate bin/gate`).
# Prints one result line last: `gate: green (…)`, or `gate: RED (…)` with exit 1. A failed step's
# last lines are shown above it; its whole log stays in the folder it names.
# Every step runs in a home of its own (task 0062): HOME, XDG_CONFIG_HOME and MUSTER_BASE in a
# temporary folder, removed at the end, and MUSTER_ROOT and TASKS_ROOT unset, so no test can reach
# this Mac's projects.json or ~/playground. The tools stay this Mac's: CARGO_HOME, RUSTUP_HOME,
# ~/.cargo/bin on PATH, and pnpm's store and cache, worked out from the real home first.
set -u
cd "$(dirname "$0")/.." || exit 2
logs=$(mktemp -d "${TMPDIR:-/tmp}/muster-gate.XXXXXX") || exit 2
passed=""
failed=""

real_home=${HOME:-}
export CARGO_HOME="${CARGO_HOME:-$real_home/.cargo}" RUSTUP_HOME="${RUSTUP_HOME:-$real_home/.rustup}"
export PATH="$PATH:$CARGO_HOME/bin"
if [ -z "${pnpm_config_store_dir:-}" ] && store=$(pnpm store path 2>/dev/null); then
  export pnpm_config_store_dir="${store%/*}"
fi
if [ -z "${pnpm_config_cache_dir:-}" ]; then
  if [ "$(uname)" = Darwin ]; then
    export pnpm_config_cache_dir="$real_home/Library/Caches/pnpm"
  else
    export pnpm_config_cache_dir="${XDG_CACHE_HOME:-$real_home/.cache}/pnpm"
  fi
fi
home=$(mktemp -d "${TMPDIR:-/tmp}/muster-gate-home.XXXXXX") || exit 2
trap 'rm -rf "$home"' EXIT
export HOME="$home" XDG_CONFIG_HOME="$home/.config" MUSTER_BASE="$home/playground"
unset MUSTER_ROOT TASKS_ROOT MUSTER_AGENT MUSTER_LANG
mkdir -p "$XDG_CONFIG_HOME" "$MUSTER_BASE" || exit 2

# step <name> <program> [args…]: run one check, its output to its log.
step() {
  name=$1
  shift
  if "$@" >"$logs/$name.log" 2>&1; then
    passed="$passed, $name"
  else
    failed="$failed, $name"
    printf -- '--- %s failed (log: %s)\n' "$name" "$logs/$name.log"
    tail -n 20 "$logs/$name.log"
  fi
}

# A fresh worktree has no node_modules yet.
if [ ! -d app/node_modules ]; then
  step "pnpm install" pnpm --dir app install --frozen-lockfile
fi
step "pnpm check" pnpm --dir app check
step "test_task" python3 -I -B bin/test_task.py
step "test_commands" python3 -I -B bin/test_commands.py
step "test_ac_verifier" python3 -I -B agents/test_ac_verifier.py
step "cargo test (Kiritimati)" env TZ=Pacific/Kiritimati cargo test --quiet --manifest-path app/src-tauri/Cargo.toml

if [ -n "$failed" ]; then
  printf 'gate: RED (failed: %s; logs in %s)\n' "${failed#, }" "$logs"
  exit 1
fi
rm -f "$logs"/*.log
rmdir "$logs"
printf 'gate: green (%s)\n' "${passed#, }"
