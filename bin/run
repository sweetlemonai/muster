#!/bin/sh
# Muster's run command (task 0077): builds the release app from the checkout it's in and starts
# that build as a second Muster beside the one running (`muster projects set muster run bin/run`).
# It becomes that build's own binary (`exec`, no `open`), so the second Muster runs in this
# script's place: in the process group Muster's Run started (0079), whose Stop, or quitting the
# first Muster, ends it, and in a terminal until it quits (or Ctrl-C). `open -n` would hand it to
# launchd, out of reach of Stop. The binary's name is the bundle's CFBundleExecutable.
# The .app is where tauri puts it: <target>/release/bundle/macos/Muster.app, the target folder
# being $CARGO_TARGET_DIR (an absolute path) or app/src-tauri/target.
set -eu
cd "$(dirname "$0")/.."
root=$(pwd -P)

target=${CARGO_TARGET_DIR:-$root/app/src-tauri/target}
case $target in
  /*) ;;
  *)
    printf 'bin/run: CARGO_TARGET_DIR is %s: give it as an absolute path\n' "$target" >&2
    exit 2
    ;;
esac
app="$target/release/bundle/macos/Muster.app"

# A fresh worktree has no node_modules yet.
if [ ! -d "$root/app/node_modules" ]; then
  pnpm --dir "$root/app" install --frozen-lockfile
fi
pnpm --dir "$root/app" release:build
if [ ! -d "$app" ]; then
  printf 'bin/run: the build finished, but %s is not there\n' "$app" >&2
  exit 1
fi
exe=$(plutil -extract CFBundleExecutable raw -o - "$app/Contents/Info.plist" 2>/dev/null) || exe=
case $exe in
  '' | */* | . | ..)
    printf 'bin/run: %s/Contents/Info.plist names no executable\n' "$app" >&2
    exit 1
    ;;
esac
printf 'bin/run: starting %s beside the Muster already running; quitting it ends the run\n' "$app"
exec "$app/Contents/MacOS/$exe"
