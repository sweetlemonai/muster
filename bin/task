#!/usr/bin/env python3
"""Muster: questions and answers for a task queue, with answers delivered to the session that asked.

  task ask <id> "<question>" [--from NAME] [--session ID]
      Adds Qn under ## Questions in the task, lists the task's questions so far, and records
      which session asked. Refuses to ask a question that's already answered word for word.
  task answer <id> Q<n> "<answer>" [--as capture|owner]
      Writes the answer under Qn, ticks it, and puts a copy in the asker's mailbox.
  task escalate <id> Q<n>
      Marks Qn "Escalated to owner"; capture adds it to WAITING-FOR-OWNER.md.
  task inbox [--session ID] [--keep]
      Prints answers waiting for this session and marks them delivered (unless --keep).

The session id comes from --session, else $CLAUDE_CODE_SESSION_ID. Mailboxes live in
mail/<first 8 chars of the session id>/ and are not committed. bin/answer-hook.py delivers them
into a running Claude Code session after each tool call.

This is a stand-in kept for scripts and agents that call `task`: it runs `muster ask`, `answer`,
`escalate` or `inbox` (one implementation of the rules), with the same arguments, on the queue in
$MUSTER_ROOT, else the one muster finds from the current folder: the repo's .muster/ (the main
checkout's, from any worktree of it), or an old <project>/tasks beside the repo. $MUSTER_BIN names
the muster to run; by default it's bin/muster beside this file.
"""
# Annotations stay text, so `list[str] | None` runs on macOS's own python3 (3.9) too.
from __future__ import annotations

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
VALUE_OPTIONS = ("--from", "--session", "--as")
# Each command and how many arguments it takes after its name.
ARITY = {"ask": 2, "answer": 3, "escalate": 2, "inbox": 0}


def muster_args(argv: list[str], folder: str, root: str | None) -> list[str] | None:
    """The `muster` command line for a `task` one, or None when it isn't a `task` command.

    Options go before `--` and the arguments after it, so a question or an answer that starts
    with `--` stays text. Who defaults as `task` always did: the asker is this folder's name
    (`ask --from` sets it), the answerer and escalator capture (`--as` sets it)."""
    args: list[str] = []
    opts: dict[str, str] = {}
    keep = False
    it = iter(argv)
    for a in it:
        if a in VALUE_OPTIONS:
            opts[a[2:]] = next(it, "")
        elif a == "--keep":
            keep = True
        else:
            args.append(a)
    if not args or args[0] not in ARITY or len(args) != ARITY[args[0]] + 1:
        return None
    cmd = args[0]
    out = [cmd]
    if root:
        out += ["--queue", root]
    if cmd == "ask":
        out += ["--as", opts.get("from") or folder]
    elif cmd in ("answer", "escalate"):
        out += ["--as", opts.get("as") or "capture"]
    if cmd in ("ask", "inbox") and opts.get("session"):
        out += ["--session", opts["session"]]
    if cmd == "inbox" and keep:
        out.append("--keep")
    return out + ["--", *args[1:]]


def main(argv: list[str]) -> int:
    root = os.environ.get("MUSTER_ROOT") or os.environ.get("TASKS_ROOT")
    args = muster_args(argv, Path.cwd().name, str(Path(root).resolve()) if root else None)
    if args is None:
        print(__doc__.strip())
        return 2
    muster = os.environ.get("MUSTER_BIN") or str(HERE / "muster")
    try:
        os.execv(muster, [muster, *args])
    except OSError as e:
        print(f"task: can't run muster ({muster}): {e}", file=sys.stderr)
        return 1
    return 0  # not reached: execv replaces this process


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
