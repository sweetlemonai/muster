#!/bin/sh
# `muster`: the command line, built into the Muster app's binary (same rules as the app).
# Put this folder on your PATH, or link this file into ~/.local/bin.
here=$(cd "$(dirname "$0")" && pwd -P)
bin="$here/../app/src-tauri/target/release/muster"
if [ ! -x "$bin" ]; then
  echo "muster: build it first: (cd $here/../app && pnpm install && pnpm release:build)" >&2
  exit 2
fi
exec "$bin" "$@"
